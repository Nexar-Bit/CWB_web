# CrowdWorks Web — copy to .env and fill in values. Load these in your shell, Docker, or host UI (Render, Railway, etc.).
#   cp .env.example .env
#
# This app does not read .env by itself; export vars or use your process manager to inject them.

# --- Required in production: signed session for /login. Use a long random string (e.g. openssl rand -hex 32). ---
SESSION_SECRET=sLtBABY7ZbiuyK@

# --- Web UI / API: optional instance token. When set, Bearer / X-Access-Token / cookie cword_web can act as
#     the shared “local” user (id 1) without email login. Unset in pure multi-user + login-only setups. ---
# CWORD_WEB_TOKEN=

# --- Set to 1 when served over HTTPS so session & token cookies are Secure. ---
# CWORD_FORCE_SECURE_COOKIES=0

# --- Registration: set to 0, false, no, or off to block /register. ---
# ALLOW_REGISTER=1

# --- OpenAI: optional here; you can also store the key in Settings in the app (per user in DB). ---
# OPENAI_API_KEY=

# --- Server port (Uvicorn / PaaS often sets this automatically). ---
# PORT=8000
